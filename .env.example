# Copy to .env (never commit .env)
# --- Humanizer provider: openrouter (free models) | huggingface | anthropic ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# "openrouter/free" auto-picks a free model; or set a specific one ending in :free
LLM_MODEL=openrouter/free
# Optional alternatives
ANTHROPIC_API_KEY=
HF_TOKEN=
TEXT_DETECTOR_MODEL=Hello-SimpleAI/chatgpt-detector-roberta
IMAGE_DETECTOR_MODEL=umm-maybe/AI-image-detector
MAX_FILE_MB=15
